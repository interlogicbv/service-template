{
  "name": "service-template",
  "version": "1.0.0",
  "private": false,
  "description": "A minimal TypeScript and Node.js starter template with Docker support for building lightweight, containerized services.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "docker",
    "template",
    "microservices"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interlogicbv/service-template.git"
  },
  "homepage": "https://github.com/interlogicbv/service-template#readme",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
